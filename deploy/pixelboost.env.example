# Copy to /etc/pixelboost/pixelboost.env and chmod 600.
# Loaded by deploy/pixelboost.service via EnvironmentFile=.
#
# Never commit the filled-in version. .gitignore already covers *.env.

# Where models and the TensorRT cache live.
PIXELBOOST_HOME=/srv/pixelboost/data
PIXELBOOST_CONFIG=/srv/pixelboost/pixelboost.yaml

# Execution provider. Leave unset for auto-detection.
# PIXELBOOST_PROVIDER=cuda

# Pin the CUDA device on a multi-GPU host.
# PIXELBOOST_CUDA_DEVICE=0

# TensorRT engine cache. First build takes 30-90 s; after that it is instant.
# PIXELBOOST_TRT_CACHE=/srv/pixelboost/data/trt
# PIXELBOOST_TRT_WORKSPACE=4294967296

# Concurrency. GPU = 1 is almost always right.
PIXELBOOST_CPU_WORKERS=2
PIXELBOOST_GPU_WORKERS=1

# Thread caps. Set these or ONNX Runtime will spawn one thread per core and
# thrash under a multi-worker setup.
OMP_NUM_THREADS=4
OPENBLAS_NUM_THREADS=4
MKL_NUM_THREADS=4

# API keys are better placed in the YAML than here so they can be rotated
# without a restart; this is here only as an example of the pattern.
# PIXELBOOST_API_KEY=sk-live-replace-me
